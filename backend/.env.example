# Copy to .env and adjust as needed.
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# SQLite database file (used from Step 1)
DB_PATH=data/inbox.db
# Requests with a larger body are rejected with 413
MAX_REQUEST_BYTES=1000000
# On startup, embed items left "pending" by a previous run
RECOVER_PENDING_ON_STARTUP=true
# URL ingestion
FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=5000000
# Check each site's robots.txt before fetching a page
RESPECT_ROBOTS_TXT=true
# Chunking (characters)
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=100

# Embeddings (see README "Switching AI providers")
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# none = provider default (e.g. for Ollama models)
EMBEDDING_DIMENSIONS=768
# Free key: https://aistudio.google.com/apikey
EMBEDDING_API_KEY=
# Only for EMBEDDING_PROVIDER=openai_compatible, e.g. https://api.openai.com/v1 or http://localhost:11434/v1
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=50
EMBEDDING_TIMEOUT_S=30
EMBEDDING_MAX_RETRIES=3

# Retrieval: chunks returned per question, and the minimum cosine similarity to count as relevant
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

# Answer generation (LLM). Leave LLM_API_KEY blank to reuse EMBEDDING_API_KEY (same provider).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Only for LLM_PROVIDER=openai_compatible, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Gemini only: 0 = "thinking" off (faster), -1 = dynamic (e.g. gemini-2.5-pro), none = omit (models without thinking)
LLM_THINKING_BUDGET=0
