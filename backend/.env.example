# Copy to .env and adjust as needed.
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# SQLite database file (used from Step 1)
DB_PATH=data/inbox.db
# URL ingestion
FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=5000000
# Check each site's robots.txt before fetching a page
RESPECT_ROBOTS_TXT=true
